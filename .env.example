# Copy this file to .env and fill in your Supabase project values.
# These are read by Expo at build time because of the EXPO_PUBLIC_ prefix.
# The anon key is a public client key (safe for the app), but is kept out of
# source control so each environment supplies its own.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
